# Local development example only.
# Never commit real secrets or production credentials to this file.

POSTGRES_DB=<your_postgres_db>
POSTGRES_USER=<your_postgres_user>
POSTGRES_PASSWORD=<set-a-local-dev-password>

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/<your_postgres_db>
SPRING_DATASOURCE_USERNAME=<your_postgres_user>
SPRING_DATASOURCE_PASSWORD=<set-a-local-dev-password>

APP_JWT_SECRET=<generate-a-random-secret-at-least-32-characters-long>
APP_JWT_EXP_MINUTES=60
APP_BOOTSTRAP_ADMIN_EMAIL=

APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_AUTH_REGISTER_LIMIT=5
APP_RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=60
APP_RATE_LIMIT_AUTH_LOGIN_LIMIT=10
APP_RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
APP_RATE_LIMIT_CREATE_POST_LIMIT=20
APP_RATE_LIMIT_CREATE_POST_WINDOW_SECONDS=60
APP_RATE_LIMIT_CREATE_REPLY_LIMIT=40
APP_RATE_LIMIT_CREATE_REPLY_WINDOW_SECONDS=60
APP_RATE_LIMIT_LIKES_LIMIT=120
APP_RATE_LIMIT_LIKES_WINDOW_SECONDS=60

APP_IDEMPOTENCY_ENABLED=true
APP_IDEMPOTENCY_TTL_MINUTES=120

APP_CACHE_MAX_SIZE=1000
APP_CACHE_TTL_SECONDS=30

ENABLE_SEARCH=true
ENABLE_GRAPH_EXPAND=true

APP_EMBEDDINGS_PROVIDER=hashing
APP_EMBEDDINGS_MODEL=semantic-hash-v3
APP_EMBEDDINGS_DIMENSIONS=192
APP_EMBEDDINGS_REINDEX_BATCH_SIZE=200
APP_EMBEDDINGS_REMOTE_BASE_URL=https://api.openai.com
APP_EMBEDDINGS_REMOTE_PATH=/v1/embeddings
APP_EMBEDDINGS_REMOTE_API_KEY=

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_OBSERVABILITY_ENABLED=true
